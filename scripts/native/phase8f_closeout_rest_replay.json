[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-REST-REPLAY",
  "seed",
  "login a",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "route [\"chat\",\"current\"]",
  "assert_ui \"当前 Conversation：{conversation}\"",
  "tap [\"使用 REST\"]",
  "fault agent_drop",
  "input [\"Agent 消息输入\",\"Synthetic native REST replay\"]",
  "tap [\"发送 Agent 消息\"]",
  "wait 8",
  "assert_ui \"无法确认该请求是否已完成。\"",
  "evidence",
  "assert_db [\"agent.runs.length\",1]",
  "assert_db [\"agent.messages.length\",2]",
  "assert_db [\"agent.calls.length\",6]",
  "assert_db [\"agent.memories\",0]",
  "tap [\"重试原操作（REST）\"]",
  "wait 3",
  "assert_ui \"Agent 状态：运行完成\"",
  "assert_ui \"合成验收🌱\"",
  "state",
  "evidence",
  "assert_same",
  "assert_db [\"agent.calls.length\",6]",
  "assert_db [\"agent.memories\",0]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
