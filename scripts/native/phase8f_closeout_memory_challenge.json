[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-MEMORY-CHALLENGE",
  "seed",
  "login a",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "save 一",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "memory_id",
  "tap [\"查看记忆 {memory}\"]",
  "assert_ui \"Memory ID：{memory}\"",
  "tap [\"准备删除记忆 {memory}\"]",
  "assert_ui \"Mutation 状态：等待你明确确认\"",
  "back",
  "open settings",
  "assert_ui \"Mutation 状态：尚未准备操作\"",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",0]",
  "tap [\"准备删除记忆 {memory}\",\"down\"]",
  "expire_confirmation",
  "tap [\"确认执行服务器删除\"]",
  "assert_ui \"Mutation 状态：服务器确认已过期\"",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",0]",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "tap [\"准备删除记忆 {memory}\"]",
  "stale_memory",
  "tap [\"确认执行服务器删除\"]",
  "assert_ui \"Mutation 状态：目标已变化或操作冲突\"",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",0]",
  "assert_db [\"memory.agent_messages\",2]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
