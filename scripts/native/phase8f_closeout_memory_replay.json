[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-MEMORY-REPLAY",
  "seed",
  "login a",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "save 一",
  "save 二",
  "history_setup [3,\"MemoryWitness\"]",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "memory_id",
  "tap [\"准备删除记忆 {memory}\"]",
  "assert_ui \"Mutation 状态：等待你明确确认\"",
  "fault memory_drop",
  "tap [\"确认执行服务器删除\"]",
  "assert_ui \"Mutation 状态：操作结果未知\"",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",1]",
  "assert_db [\"memory.agent_messages\",4]",
  "assert_db [\"memory.relationship_messages\",3]",
  "tap [\"安全重试原 Memory 操作\"]",
  "assert_ui \"Mutation 状态：正式回执已确认\"",
  "assert_ui \"本次响应 replayed：是\"",
  "receipt_id",
  "input [\"已知 Mutation ID\",\"{receipt}\"]",
  "tap [\"查询服务器持久化回执\"]",
  "assert_ui \"Mutation ID：{receipt}\"",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",1]",
  "assert_db [\"memory.agent_messages\",4]",
  "assert_db [\"memory.relationship_messages\",3]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
