[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-RELATIONSHIP-ISOLATION",
  "seed ScopeA",
  "history_setup [101,\"ScopeA\"]",
  "bookmark a",
  "seed ScopeB",
  "history_setup [3,\"ScopeB\"]",
  "bookmark b",
  "login a",
  "scope a",
  "route [\"import\",\"a\"]",
  "input [\"已有 ImportJob UUID\",\"{job}\"]",
  "tap [\"读取已有 Job（不上传）\"]",
  "assert_ui \"Job ID：{job}\"",
  "assert_ui \"Relationship：{relationship}\"",
  "route [\"history\",\"a\"]",
  "assert_ui \"范围：{relationship} · 已读取 100 条\"",
  "tap [\"加载更多服务器历史\"]",
  "assert_ui \"范围：{relationship} · 已读取 101 条\"",
  "state",
  "back",
  "scope b",
  "route [\"relationship\",\"b\"]",
  "assert_ui \"所属 Person：ScopeB · {person}\"",
  "route [\"history\",\"b\"]",
  "assert_ui \"范围：{relationship} · 已读取 3 条\"",
  "assert_absent [\"Synthetic ScopeA history occurrence.\"]",
  "state",
  "tap [\"进入真实导入\"]",
  "assert_ui \"文件状态：未选择\"",
  "assert_absent [\"Job ID：\",\"Synthetic ScopeA\"]",
  "state",
  "route [\"chat\",\"b\"]",
  "assert_ui \"当前 Conversation：{conversation}\"",
  "assert_ui \"关系范围：{relationship}\"",
  "input [\"Agent 消息输入\",\"Synthetic Scope B chat\"]",
  "tap [\"发送 Agent 消息\"]",
  "wait 8",
  "assert_ui \"Agent 状态：运行完成\"",
  "scope a",
  "route [\"history\",\"a\"]",
  "assert_ui \"范围：{relationship} · 已读取 100 条\"",
  "home",
  "route [\"history\",\"a\"]",
  "assert_ui \"范围：{relationship} · 已读取 100 条\"",
  "back",
  "fault hold_history",
  "route [\"history\",\"a\"]",
  "scope b",
  "route [\"history\",\"b\"]",
  "assert_ui \"范围：{relationship} · 已读取 3 条\"",
  "fault release_get",
  "wait 3",
  "assert_ui \"范围：{relationship} · 已读取 3 条\"",
  "assert_absent [\"Synthetic ScopeA history occurrence.\"]",
  "route [\"import\",\"b\"]",
  "assert_ui \"文件状态：未选择\"",
  "state",
  "evidence",
  "assert_db [\"import.messages\",104]",
  "assert_db [\"agent.messages.length\",2]",
  "scope missing",
  "route [\"history\",\"missing\"]",
  "assert_ui \"资源不存在或不属于当前会话。\"",
  "assert_ui \"已读取 0 条\"",
  "route [\"import\",\"missing\"]",
  "assert_ui \"资源不存在或不属于当前会话。\"",
  "state",
  "evidence",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
