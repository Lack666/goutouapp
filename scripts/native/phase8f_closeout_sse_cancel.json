[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-SSE-CANCEL",
  "seed",
  "login a",
  "route [\"chat\",\"current\"]",
  "fault slow_run",
  "input [\"Agent 消息输入\",\"Synthetic cancel waiting\"]",
  "tap [\"发送 Agent 消息\"]",
  "tap [\"停止等待\"]",
  "state",
  "observe",
  "assert_ui \"无法确认该请求是否已完成。\"",
  "observe cancelled",
  "wait 8",
  "observe cancelled",
  "assert_observer_same",
  "evidence",
  "assert_db [\"agent.runs.length\",1]",
  "assert_db [\"agent.messages.length\",1]",
  "assert_db [\"agent.memories\",0]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
