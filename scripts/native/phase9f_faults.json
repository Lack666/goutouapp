[
  "restart",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 9F-FAULTS",
  "seed ErasureFaults",
  "bookmark erase",
  "login a",
  "route [\"chat\",\"erase\"]",
  "tap [\"向服务器准备删除\"]",
  "expire_erasure",
  "tap [\"明确确认并执行此范围删除\"]",
  "assert_ui \"删除状态：expired\"",
  "tap [\"向服务器准备删除\"]",
  "fault erasure_drop",
  "tap [\"明确确认并执行此范围删除\"]",
  "assert_ui \"删除状态：unknown_outcome\"",
  "evidence",
  "assert_db [\"erasure.receipts.length\",1]",
  "tap [\"同 key 安全重放原删除\"]",
  "assert_ui \"删除状态：completed\"",
  "assert_ui \"权威刷新：verified\"",
  "assert_erasure_replay",
  "seed ErasureBusy",
  "bookmark busy",
  "busy_conversation",
  "route [\"chat\",\"busy\"]",
  "tap [\"向服务器准备删除\"]",
  "assert_ui \"删除状态：target_busy\"",
  "tap [\"主动刷新 Busy 状态\"]",
  "tap [\"向服务器准备删除\"]",
  "assert_ui \"删除状态：target_busy\"",
  "assert_erased [\"conversation\",\"busy\",false,0]",
  "evidence",
  "assert_db [\"erasure.receipts.length\",1]",
  "assert_identity",
  "stop"
]
