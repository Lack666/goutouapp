[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-MEMORY-SMOKE-PRESERVE",
  "seed MemoryA",
  "bookmark a",
  "seed MemoryB",
  "bookmark b",
  "login a",
  "assert_ui \"Consent：未授权\"",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "scope a",
  "save 一",
  "save 二",
  "history_setup [3,\"PreserveWitness\"]",
  "scope b",
  "save 三",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "assert_ui \"当前窗口：3 条\"",
  "tap [\"暂停记忆\",\"down\"]",
  "assert_ui \"Pause：已暂停\"",
  "evidence",
  "assert_db [\"memory.controls.0.paused\",true]",
  "tap [\"恢复记忆\"]",
  "assert_ui \"Pause：未暂停\"",
  "tap [\"撤销长期记忆授权\"]",
  "assert_ui \"Consent：未授权\"",
  "evidence",
  "assert_db [\"memory.memories\",3]",
  "assert_db [\"memory.controls.0.consent_enabled\",false]",
  "tap [\"授权长期记忆\"]",
  "assert_ui \"Consent：已授权\"",
  "tap [\"恢复记忆\"]",
  "assert_ui \"Pause：未暂停\"",
  "tap [\"检查最新 Undo 并准备确认\"]",
  "state",
  "assert_ui \"Mutation 状态：等待你明确确认\"",
  "state",
  "tap [\"确认撤销该最新操作\"]",
  "assert_ui \"Mutation 状态：正式回执已确认\"",
  "evidence",
  "assert_db [\"memory.memories\",2]",
  "assert_db [\"memory.receipts\",1]",
  "assert_db [\"memory.agent_messages\",6]",
  "assert_db [\"memory.relationship_messages\",3]",
  "scope a",
  "memory_id",
  "tap [\"查看记忆 {memory}\",\"down\"]",
  "assert_ui \"Memory ID：{memory}\"",
  "tap [\"准备删除记忆 {memory}\"]",
  "tap [\"确认执行服务器删除\"]",
  "assert_ui \"Mutation 状态：正式回执已确认\"",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",2]",
  "assert_db [\"memory.agent_messages\",6]",
  "assert_db [\"memory.relationship_messages\",3]",
  "tap [\"全部删除后保留授权\"]",
  "tap [\"准备删除全部本人记忆\"]",
  "assert_ui \"删除后撤销授权：否\"",
  "tap [\"确认执行服务器删除\"]",
  "assert_ui \"Mutation 状态：正式回执已确认\"",
  "receipt_id",
  "input [\"已知 Mutation ID\",\"{receipt}\"]",
  "tap [\"查询服务器持久化回执\"]",
  "assert_ui \"Mutation ID：{receipt}\"",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "evidence",
  "assert_db [\"memory.memories\",0]",
  "assert_db [\"memory.receipts\",3]",
  "assert_db [\"memory.controls.0.consent_enabled\",true]",
  "assert_db [\"memory.controls.0.paused\",false]",
  "assert_db [\"memory.agent_messages\",6]",
  "assert_db [\"memory.relationship_messages\",3]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
