[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-MEMORY-RESTART",
  "seed",
  "login a",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "save 一",
  "save 二",
  "tap [\"重新读取 Memory 权威状态\",\"down\"]",
  "memory_id",
  "tap [\"准备删除记忆 {memory}\"]",
  "fault memory_drop",
  "tap [\"确认执行服务器删除\"]",
  "assert_ui \"Mutation 状态：操作结果未知\"",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",1]",
  "receipt_id",
  "restart",
  "tap [\"开发会话已连接\",\"down\"]",
  "tap [\"重新读取 Memory 权威状态\"]",
  "assert_ui \"当前窗口：1 条\"",
  "assert_ui \"Mutation 状态：尚未准备操作\"",
  "assert_ui \"重启后丢失原操作标识\"",
  "assert_ui \"尚无已确认的服务器回执。\"",
  "state",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",1]",
  "input [\"已知 Mutation ID\",\"{receipt}\"]",
  "tap [\"查询服务器持久化回执\"]",
  "assert_ui \"Mutation ID：{receipt}\"",
  "assert_ui \"Mutation 状态：尚未准备操作\"",
  "evidence",
  "assert_db [\"memory.memories\",1]",
  "assert_db [\"memory.receipts\",1]",
  "assert_db [\"memory.agent_messages\",4]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
