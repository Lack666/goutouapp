[
  "open settings",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 8F-RESOURCE-CREATE",
  "login a",
  "open relationship",
  "input [\"Person 显示名称\",\"8FNativeCreate\"]",
  "tap [\"创建新 Person\"]",
  "assert_ui \"服务器已确认保存 persons\"",
  "adopt",
  "tap [\"查看 persons 8FNativeCreate\",\"down\"]",
  "assert_ui \"UUID：{person}\"",
  "tap [\"使用 Person 8FNativeCreate\"]",
  "input [\"关系类型（必填）\",\"unknown\"]",
  "input [\"关系状态（必填）\",\"unknown\"]",
  "tap [\"创建新 Relationship\"]",
  "assert_ui \"服务器已确认保存 relationships\"",
  "adopt",
  "tap [\"查看 relationships 8FNativeCreate\",\"down\"]",
  "assert_ui \"UUID：{relationship}\"",
  "assert_ui \"所属 Person：8FNativeCreate · {person}\"",
  "tap [\"绑定 Relationship {relationship}\"]",
  "tap [\"创建新 Conversation\"]",
  "assert_ui \"服务器已确认保存 conversations\"",
  "adopt",
  "tap [\"查看 conversations {conversation}\",\"down\"]",
  "assert_ui \"UUID：{conversation}\"",
  "assert_ui \"绑定关系：{relationship}\"",
  "open settings",
  "open relationship",
  "tap [\"刷新 persons\",\"down\"]",
  "tap [\"查看 persons 8FNativeCreate\"]",
  "assert_ui \"UUID：{person}\"",
  "tap [\"刷新 relationships\"]",
  "tap [\"查看 relationships 8FNativeCreate\"]",
  "assert_ui \"UUID：{relationship}\"",
  "tap [\"刷新 conversations\"]",
  "tap [\"查看 conversations {conversation}\"]",
  "assert_ui \"UUID：{conversation}\"",
  "state",
  "evidence",
  "assert_db [\"resources.persons\",1]",
  "assert_db [\"resources.relationships\",1]",
  "assert_db [\"resources.conversations\",1]",
  "tap [\"清除当前开发会话\",\"down\"]",
  "stop"
]
