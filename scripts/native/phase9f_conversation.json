[
  "restart",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 9F-CONVERSATION",
  "seed EraseConversation",
  "bookmark erase",
  "login a",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "save 一",
  "seed KeepConversation",
  "bookmark keep",
  "save 二",
  "scope erase",
  "route [\"chat\",\"erase\"]",
  "tap [\"向服务器准备删除\"]",
  "assert_ui \"服务器待删消息：2\"",
  "tap [\"明确确认并执行此范围删除\"]",
  "assert_ui \"删除状态：completed\"",
  "assert_ui \"Receipt ID：\"",
  "assert_ui \"权威刷新：verified\"",
  "tap [\"查询正式删除回执\"]",
  "assert_ui \"删除状态：completed\"",
  "assert_erased [\"conversation\",\"erase\",true,0]",
  "assert_erased [\"conversation\",\"keep\",false,2]",
  "assert_erasure_http [\"erase\",404]",
  "assert_erasure_http [\"keep\",200]",
  "evidence",
  "assert_db [\"erasure.receipts.length\",1]",
  "assert_db [\"erasure.memories\",2]",
  "assert_identity",
  "stop"
]
