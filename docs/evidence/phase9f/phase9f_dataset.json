[
  "restart",
  "tap [\"清除当前开发会话\",\"down\"]",
  "case 9F-DATASET",
  "seed ErasureNative",
  "bookmark erase",
  "login a",
  "tap [\"授权长期记忆\"]",
  "tap [\"恢复记忆\"]",
  "save 一",
  "history_setup [4,\"EraseDataset\"]",
  "bookmark erase",
  "history_setup [2,\"KeepDataset\"]",
  "bookmark keep",
  "seed OtherNative",
  "history_setup [3,\"OtherDataset\"]",
  "bookmark other",
  "scope erase",
  "route [\"history\",\"erase\"]",
  "tap [\"选择删除 Dataset {job}\"]",
  "tap [\"向服务器准备删除\"]",
  "assert_ui \"服务器待删消息：4\"",
  "tap [\"取消本次删除确认\"]",
  "evidence",
  "assert_db [\"erasure.receipts.length\",0]",
  "tap [\"向服务器准备删除\"]",
  "tap [\"明确确认并执行此范围删除\"]",
  "assert_ui \"删除状态：completed\"",
  "assert_ui \"Receipt ID：\"",
  "assert_ui \"权威刷新：verified\"",
  "assert_erased [\"dataset\",\"erase\",true,0]",
  "assert_erased [\"dataset\",\"keep\",false,2]",
  "assert_erased [\"dataset\",\"other\",false,3]",
  "evidence",
  "assert_db [\"erasure.receipts.length\",1]",
  "assert_db [\"erasure.memories\",1]",
  "assert_db [\"memory.agent_messages\",2]",
  "tap [\"同 key 安全重放原删除\"]",
  "assert_ui \"权威刷新：verified\"",
  "evidence",
  "assert_db [\"erasure.receipts.length\",1]",
  "assert_identity",
  "stop"
]
