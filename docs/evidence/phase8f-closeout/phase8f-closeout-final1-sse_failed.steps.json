[
  "restart",
  "open settings",
  "tap [\"\u6e05\u9664\u5f53\u524d\u5f00\u53d1\u4f1a\u8bdd\",\"down\"]",
  "case 8F-SSE-FAILED",
  "seed",
  "login a",
  "route [\"chat\",\"current\"]",
  "fault provider_failed",
  "input [\"Agent \u6d88\u606f\u8f93\u5165\",\"Synthetic native controlled failure\"]",
  "tap [\"\u53d1\u9001 Agent \u6d88\u606f\"]",
  "wait 3",
  "observe failed",
  "assert_ui \"Agent \u72b6\u6001\uff1a\u8fd0\u884c\u5931\u8d25\"",
  "evidence",
  "assert_db [\"agent.runs.length\",1]",
  "assert_db [\"agent.runs.0.status\",\"failed\"]",
  "assert_db [\"agent.messages.length\",1]",
  "assert_db [\"agent.messages.0.role\",\"user\"]",
  "assert_db [\"agent.memories\",0]",
  "tap [\"\u6e05\u9664\u5f53\u524d\u5f00\u53d1\u4f1a\u8bdd\",\"down\"]",
  "stop"
]