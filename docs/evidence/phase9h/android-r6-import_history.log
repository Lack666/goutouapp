ds": "[108,2001][972,2132]", "enabled": "false"}, {"text": "加载更多服务器历史", "label": "", "bounds": "[152,2035][928,2098]", "enabled": "true"}, {"text": "每次最多 100 条，按正式 Message ID 合并；同时间或同内容的不同消息全部保留。", "label": "", "bounds": "[107,2163][973,2295]", "enabled": "true"}]
