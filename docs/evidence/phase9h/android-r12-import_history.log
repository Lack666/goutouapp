[{"text": "", "label": "Tools", "bounds": "[937,219][1005,287]", "enabled": "true"}, {"text": "", "label": "历史消息列表", "bounds": "[0,142][1080,1827]", "enabled": "true"}, {"text": "可单独删除指定导入 Dataset 或 AI Conversation；Memory 通过独立控制删除。", "label": "", "bounds": "[42,142][1038,194]", "enabled": "true"}, {"text": "历史类型", "label": "", "bounds": "[107,260][973,337]", "enabled": "true"}, {"text": "", "label": "关系聊天", "bounds": "[108,369][972,500]", "enabled": "true"}, {"text": "关系聊天", "label": "", "bounds": "[152,403][928,466]", "enabled": "true"}, {"text": "", "label": "AI 对话", "bounds": "[108,532][972,663]", "enabled": "true"}, {"text": "AI 对话", "label": "", "bounds": "[152,566][928,629]", "enabled": "true"}, {"text": "AI 对话是 Conversation user/assistant；关系聊天是导入的 self/person/system，两者分别读取。", "label": "", "bounds": "[107,694][973,892]", "enabled": "true"}, {"text": "明确选择 Conversation", "label": "", "bounds": "[107,1023][973,1100]", "enabled": "true"}, {"text": "", "label": "历史 Conversation 5a89e55f-d9bb-4b6a-8241-befa243a4b7c", "bounds": "[108,1132][972,1326]", "enabled": "true"}, {"text": "历史 Conversation 5a89e55f-d9bb-4b6a-8241-befa243a4b7c", "label": "", "bounds": "[152,1166][928,1292]", "enabled": "true"}, {"text": "删除指定 AI Conversation", "label": "", "bounds": "[107,1457][973,1534]", "enabled": "true"}, {"text": "仅删除指定主库历史。Dataset 删除移除正式 RelationshipMessage 和对应说话人记录，保留必要 Tombstone / 去重 / 回执元数据；同关系相同 Dataset 再次 Finalize 可能返回 dataset_deleted。Conversation 删除仅移除该 AI 对话消息并保留运行与操作标识。其他 Dataset、Relationship、Conversation 不受影响；Memory 不会自动删除，请使用独立 Memory Controls。旧备份可能仍含历史内容，恢复前须受控核对。", "label": "", "bounds": "[107,1566][973,1827]", "enabled": "true"}, {"text": "删除目标：5a89e55f-d9bb-4b6a-8241-befa243a4b7c", "label": "", "bounds": "[107,2257][973,1827]", "enabled": "true"}, {"text": "删除状态：idle", "label": "", "bounds": "[107,2421][973,1827]", "enabled": "true"}, {"text": "有界分页", "label": "", "bounds": "[107,1892][973,1969]", "enabled": "true"}, {"text": "", "label": "加载更多服务器历史", "bounds": "[108,2001][972,2132]", "enabled": "false"}, {"text": "加载更多服务器历史", "label": "", "bounds": "[152,2035][928,2098]", "enabled": "true"}, {"text": "每次最多 100 条，按正式 Message ID 合并；同时间或同内容的不同消息全部保留。", "label": "", "bounds": "[107,2163][973,2295]", "enabled": "true"}]
