# Preserve canonical OpenAPI generation input bytes on every checkout.
docs/contracts/*.json text eol=lf
apps/mobile/src/api/generated/*.ts text eol=lf
# Mobile Prettier requires LF even when Windows global core.autocrlf is true.
apps/mobile/** text=auto eol=lf
# Native acceptance hashes cover the original execution bytes, including newlines.
docs/evidence/phase8f-closeout/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Original console output includes intentional whitespace; do not rewrite hashed logs.
docs/evidence/phase8f-closeout/*.log whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
# Phase 9A evidence retains original execution bytes for its hash gate.
docs/evidence/phase9a/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9b/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9c/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9d/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9e/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9f/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9g/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/evidence/phase9h/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
# Preserve actual human submissions and the closeout's byte-bound evidence.
evals/agent/results/independent-human-review-15-v1.json -text
evals/agent/results/independent-safety-review-15-v1.json -text
evals/agent/results/independent-human-review-15-v1-summary.md -text
evals/agent/results/independent-safety-review-15-v1-summary.md -text
evals/agent/results/phase11-quality-closeout-v1.json -text whitespace=cr-at-eol
docs/evidence/phase11-quality-closeout/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
# Phase11Q source plans and immutable synthetic execution evidence retain bytes.
evals/agent/q11-*.json* -text whitespace=cr-at-eol
evals/agent/results/q11-* -text whitespace=cr-at-eol
docs/evidence/phase11q/** -text whitespace=cr-at-eol
