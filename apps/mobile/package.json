{
  "name": "@goutou/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:features": "jest --runInBand tests/chat.test.tsx tests/relationship.test.tsx",
    "test:controls": "jest --runInBand tests/import.test.tsx tests/history.test.tsx tests/settings.test.tsx tests/controls.test.tsx",
    "test:integration": "jest --runInBand tests/integration.test.tsx",
    "test:connected": "jest --runInBand tests/connected.test.ts tests/sessionIsolation.test.ts",
    "test:sse": "jest --runInBand tests/sseParser.test.ts",
    "test:agent-chat": "jest --runInBand tests/agentChat.test.ts tests/connectedChatUI.test.tsx",
    "test:imports": "jest --runInBand tests/connectedImport.test.ts tests/connectedHistory.test.ts tests/filePicker.test.ts tests/connectedImportUI.test.tsx",
    "test:memory": "jest --runInBand tests/connectedMemory.test.ts tests/connectedMemoryUI.test.tsx",
    "test:final": "jest --runInBand tests/fullMobileIntegration.test.ts",
    "smoke:final": "playwright test --config playwright.final.config.ts",
    "smoke:memory": "playwright test --config playwright.memory.config.ts",
    "smoke:imports": "playwright test --config playwright.import.config.ts",
    "smoke:agent": "playwright test --config playwright.agent.config.ts",
    "demo:agent": "playwright test --config playwright.agent.config.ts",
    "smoke:connected": "playwright test --config playwright.connected.config.ts",
    "compatibility": "expo install --check",
    "export:web": "expo export --platform web",
    "smoke:web": "playwright test",
    "demo:final": "playwright test smoke/integration.spec.ts"
  },
  "dependencies": {
    "expo": "57.0.27",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.12",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.8.1",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  }
}
