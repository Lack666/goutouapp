# Local development only. Copy to .env and replace credentials outside development.
# Keep real credentials in .env or a secret manager; never commit them.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://goutou_dev:goutou_dev_only@127.0.0.1:5433/goutou_dev
# Tests use a disposable database created under this separate _test namespace.
TEST_DATABASE_URL=postgresql+psycopg://goutou_dev:goutou_dev_only@127.0.0.1:5433/goutou_test
POSTGRES_USER=goutou_dev
POSTGRES_PASSWORD=goutou_dev_only
POSTGRES_DB=goutou_dev
POSTGRES_PORT=5433
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Configure a private random secret of at least 32 bytes before using the Agent REST endpoint.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=goutouapp
AUTH_JWT_AUDIENCE=goutouapp-api
CHAT_IMPORT_ARTIFACT_ROOT=.cache/import-artifacts
MAX_CHAT_IMPORT_BYTES=104857600
CHAT_IMPORT_RETENTION_HOURS=72
